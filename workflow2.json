    {
      "parameters": {
        "jsCode": "// Sub-workflow input beklenen format:\n// $json.input -> JSON string (tek işletme)  VEYA direkt object\n\nconst raw = $json.input;\n\nif (!raw) {\n  return [{\n    json: { _error: \"input gelmedi\", _raw: $json }\n  }];\n}\n\nlet obj = raw;\nif (typeof raw === \"string\") {\n  try {\n    obj = JSON.parse(raw);\n  } catch (e) {\n    return [{\n      json: { _error: \"input JSON parse edilemedi\", _raw: raw }\n    }];\n  }\n}\n\n// Opening hours normalize\nlet opening =\n  obj[\"Opening Hours\"] ??\n  obj.OpeningHours ??\n  obj.openingHours ??\n  obj.opening_hours ??\n  \"N/A\";\n\nlet openingStr = opening;\nif (opening && typeof opening === \"object\") {\n  // {Monday:\"...\", Tuesday:\"...\"} gibi gelirse tek stringe çevir\n  openingStr = Object.entries(opening)\n    .map(([day, hours]) => `${day}: ${hours}`)\n    .join(\" | \");\n}\n\nconst numberRaw = obj.Number ?? obj.phoneNumber ?? obj.number ?? \"N/A\";\nconst number = String(numberRaw).replace(/^\\+/, \"\").trim();\n\nreturn [{\n  json: {\n    UUID: String(obj.UUID ?? obj.uuid ?? obj.placeId ?? obj.place_id ?? obj.cid ?? \"\").trim(),\n    Name: obj.Name ?? obj.title ?? \"N/A\",\n    Background: obj.Background ?? obj.type ?? \"N/A\",\n    Address: obj.Address ?? obj.address ?? \"N/A\",\n    Number: number || \"N/A\",\n    Website: obj.Website ?? obj.website ?? \"N/A\",\n    Rating: obj.Rating ?? obj.rating ?? \"N/A\",\n    \"Opening Hours\": openingStr || \"N/A\",\n    Email: obj.Email ?? obj.email ?? \"N/A\",\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
